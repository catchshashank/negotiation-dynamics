def write_manifest(run_info: dict, repo_root: Path, input_file: Path, params: dict, outputs: list[str]):
    manifest = {
        "timestamp": datetime.now().astimezone().isoformat(),
        "input_file": str(input_file),
        "input_sha256": run_info["file_hash"],
        "file_stem": run_info["file_stem"],
        "run_date": run_info["run_date"],
        "pipeline_git_sha": git_head_sha(repo_root),
        "params": params,
        "outputs": outputs
    }
    manifest_path = run_info["inputs_dir"] / "manifest.json"
    manifest_path.write_text(json.dumps(manifest, indent=2), encoding="utf-8")
    return manifest_path
